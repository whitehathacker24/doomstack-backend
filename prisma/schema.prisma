datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum VillainClass {
  HENCHMAN
  MASTERMIND
  MAD_SCIENTIST
  CRIME_LORD
  SUPER_VILLAIN
  CORRUPT_CEO
  MERCENARY
  OVERLORD
}

model User {
  id           String         @id @default(uuid())
  villainName  String
  username     String         @unique
  email        String         @unique
  passwordHash String
  villainClass VillainClass   @default(MAD_SCIENTIST)
  lairLocation String
  headline     String?
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  posts        Post[]
  sightings    HeroSighting[]
  sentMessages Message[]      @relation("SentMessages")
  recvMessages Message[]      @relation("RecvMessages")
  bounties     Bounty[]
}

model Post {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model HeroSighting {
  id          String   @id @default(uuid())
  heroName    String
  location    String
  dangerLevel Int
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  createdAt   DateTime @default(now())
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("RecvMessages", fields: [recipientId], references: [id])
  content     String?
  imageUrl    String?  // Supports uploaded images
  createdAt   DateTime @default(now())
}

model Bounty {
  id          String   @id @default(uuid())
  title       String
  target      String
  description String
  reward      String
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
}