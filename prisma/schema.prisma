datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum VillainClass {
  HENCHMAN
  MASTERMIND
  MAD_SCIENTIST
  CRIME_LORD
  SUPER_VILLAIN
  CORRUPT_CEO
  MERCENARY
  OVERLORD
}

model User {
  id           String         @id @default(uuid())
  villainName  String
  username     String         @unique
  email        String         @unique
  passwordHash String
  villainClass VillainClass   @default(MAD_SCIENTIST)
  lairLocation String
  headline     String?
  avatarUrl    String?
  catchphrase  String?
  nemesis      String?
  status       String         @default("offline") // online | offline | plotting
  role         String         @default("USER")    // USER | ADMIN
  banned       Boolean        @default(false)
  mutedUntil   DateTime?
  coins        Int            @default(100)
  notoriety    Int            @default(0)
  evilCv       String?
  createdAt    DateTime       @default(now())
  posts        Post[]
  sightings    HeroSighting[]
  sentMessages Message[]      @relation("SentMessages")
  recvMessages Message[]      @relation("RecvMessages")
  bounties     Bounty[]       @relation("Created")
  claimed      Bounty[]       @relation("Claimed")
  likes        Like[]
  comments     Comment[]
  societies    SocietyMember[]
  societyMsgs  SocietyMessage[]
  following    Follow[]       @relation("Follower")
  followers    Follow[]       @relation("Followed")
  endorsesMade Endorsement[]  @relation("Endorser")
  endorsedBy   Endorsement[]  @relation("Endorsed")
  notifications Notification[]
  sightingVotes SightingVote[]
}

model Post {
  id        String    @id @default(uuid())
  content   String
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  likes     Like[]
  comments  Comment[]
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

model Like {
  id     String @id @default(uuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model HeroSighting {
  id          String   @id @default(uuid())
  heroName    String
  location    String
  dangerLevel Int
  confirms    Int      @default(0)
  falseAlarms Int      @default(0)
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  votes       SightingVote[]
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// One vote per user per sighting (confirm = true, false alarm = false)
model SightingVote {
  id         String       @id @default(uuid())
  sightingId String
  userId     String
  confirm    Boolean
  sighting   HeroSighting @relation(fields: [sightingId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sightingId, userId])
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("RecvMessages", fields: [recipientId], references: [id])
  content     String?
  imageUrl    String?   // Supports uploaded images
  readAt      DateTime?
  editedAt    DateTime?
  replyToId   String?
  pinned      Boolean   @default(false)
  expiresAt   DateTime? // self-destruct time
  reactions   Json      @default("{}") // { "😈": ["userId"] }
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([expiresAt])
}

model Bounty {
  id          String    @id @default(uuid())
  title       String
  target      String
  description String
  reward      String
  category    String    @default("GENERAL") // SABOTAGE | THEFT | RECON | GENERAL
  status      String    @default("OPEN")    // OPEN | IN_PROGRESS | COMPLETED
  rewardCoins Int       @default(0)         // held in escrow until completion
  expiresAt   DateTime?
  creatorId   String
  creator     User      @relation("Created", fields: [creatorId], references: [id])
  claimerId   String?
  claimer     User?     @relation("Claimed", fields: [claimerId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model Society {
  id         String           @id @default(uuid())
  name       String
  inviteCode String           @unique
  createdAt  DateTime         @default(now())
  members    SocietyMember[]
  messages   SocietyMessage[]
}

model SocietyMember {
  id        String  @id @default(uuid())
  societyId String
  userId    String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([societyId, userId])
}

model SocietyMessage {
  id        String   @id @default(uuid())
  societyId String
  senderId  String
  content   String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())

  @@index([societyId, createdAt])
}

model Follow {
  id         String @id @default(uuid())
  followerId String
  followedId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User   @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
}

model Endorsement {
  id         String @id @default(uuid())
  endorserId String
  endorsedId String
  skill      String
  endorser   User   @relation("Endorser", fields: [endorserId], references: [id], onDelete: Cascade)
  endorsed   User   @relation("Endorsed", fields: [endorsedId], references: [id], onDelete: Cascade)

  @@unique([endorserId, endorsedId, skill])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
